# Database
DATABASE_URL="postgresql://startup:startup@localhost:5432/startup_club?schema=public"

# API security - productionda uzun, tasodifiy qiymatlar bilan almashtiring
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Runtime
PORT="4000"
# Bitta production servisida web va API birga ishlaganda ichki API porti
API_PORT=""
WEB_ORIGIN="http://localhost:3000"
API_INTERNAL_URL="http://localhost:4000"
NODE_ENV="development"

# Initial administrator (seed)
SEED_ADMIN_EMAIL="admin@startupclub.uz"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Tizim administratori"
SEED_ORGANIZATION_NAME="StartUp Club"

# Optional S3-compatible storage (V1.1)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="startup-club"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
