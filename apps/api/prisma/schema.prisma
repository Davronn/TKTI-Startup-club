generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
}

enum StartupStatus {
  ACTIVE
  PAUSED
  GRADUATED
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT
  STAGE_CHANGE
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  FUNDING
}

enum FinanceTransactionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum FinanceCategory {
  SALES
  SERVICES
  GRANT
  INVESTMENT
  LOAN
  EQUIPMENT
  SOFTWARE
  MARKETING
  SALARY
  RENT
  OPERATIONS
  TAX
  TRAVEL
  OTHER
}

enum FundingRoundType {
  BOOTSTRAP
  GRANT
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
  SERIES_C
  OTHER
}

enum FundingRoundStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  stages      StartupStage[]
  startups    Startup[]
  tags        Tag[]
  auditLogs   AuditLog[]
  financeTransactions StartupFinanceTransaction[]
  fundingRounds StartupFundingRound[]
  milestones StartupMilestone[]
  cashTransactions CashTransaction[]
  cashReceipts     CashReceipt[]
  cashSettings     CashSettings?

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships    OrganizationMember[]
  curatedStartups Startup[]             @relation("StartupCurator")
  createdStartups Startup[]             @relation("StartupCreatedBy")
  updatedStartups Startup[]             @relation("StartupUpdatedBy")
  stageChanges   StartupStageHistory[]
  notes          StartupNote[]
  sessions       UserSession[]
  auditLogs      AuditLog[]
  uploadedFiles  StartupFile[]
  financeProfilesUpdated StartupFinanceProfile[]     @relation("FinanceProfileUpdatedBy")
  financeTransactionsCreated StartupFinanceTransaction[] @relation("FinanceTransactionCreatedBy")
  financeTransactionsUpdated StartupFinanceTransaction[] @relation("FinanceTransactionUpdatedBy")
  fundingRoundsCreated StartupFundingRound[]          @relation("FundingRoundCreatedBy")
  fundingRoundsUpdated StartupFundingRound[]          @relation("FundingRoundUpdatedBy")
  assignedMilestones StartupMilestone[]               @relation("MilestoneAssignee")
  createdMilestones StartupMilestone[]                @relation("MilestoneCreatedBy")
  updatedMilestones StartupMilestone[]                @relation("MilestoneUpdatedBy")
  cashTransactionsCreated  CashTransaction[] @relation("CashTransactionCreatedBy")
  cashTransactionsUpdated  CashTransaction[] @relation("CashTransactionUpdatedBy")
  cashTransactionsArchived CashTransaction[] @relation("CashTransactionArchivedBy")
  cashReceipts             CashReceipt[]
  cashSettingsUpdated      CashSettings[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid @map("organization_id")
  userId         String           @db.Uuid @map("user_id")
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model StartupStage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid @map("organization_id")
  name           String
  slug           String
  color          String   @default("#64748B")
  position       Int
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startups     Startup[]
  fromHistory  StartupStageHistory[] @relation("FromStage")
  toHistory    StartupStageHistory[] @relation("ToStage")

  @@unique([organizationId, slug])
  @@unique([organizationId, position])
  @@index([organizationId, isActive])
  @@map("startup_stages")
}

model Startup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid @map("organization_id")
  name           String
  slug           String
  description    String?
  problem        String?
  solution       String?
  industry       String?
  website        String?
  email          String?
  phone          String?
  location       String?
  teamSize       Int?          @map("team_size")
  foundedAt      DateTime?     @map("founded_at") @db.Date
  joinedAt       DateTime      @default(now()) @map("joined_at") @db.Date
  logoUrl        String?       @map("logo_url")
  pitchDeckUrl   String?       @map("pitch_deck_url")
  status         StartupStatus @default(ACTIVE)
  currentStageId String        @db.Uuid @map("current_stage_id")
  curatorId      String?       @db.Uuid @map("curator_id")
  createdById    String        @db.Uuid @map("created_by_id")
  updatedById    String        @db.Uuid @map("updated_by_id")
  metadata       Json?
  archivedAt     DateTime?     @map("archived_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentStage StartupStage          @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  curator      User?                 @relation("StartupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  createdBy    User                  @relation("StartupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                  @relation("StartupUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  members      StartupMember[]
  stageHistory StartupStageHistory[]
  notes        StartupNote[]
  files        StartupFile[]
  tags         StartupTag[]
  financeProfile StartupFinanceProfile?
  financeTransactions StartupFinanceTransaction[]
  fundingRounds StartupFundingRound[]
  milestones StartupMilestone[]

  cashTransactions CashTransaction[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, currentStageId])
  @@index([organizationId, curatorId])
  @@index([organizationId, createdAt])
  @@map("startups")
}

model StartupMember {
  id          String   @id @default(uuid()) @db.Uuid
  startupId   String   @db.Uuid @map("startup_id")
  fullName    String   @map("full_name")
  role        String?
  email       String?
  phone       String?
  linkedinUrl String?  @map("linkedin_url")
  isFounder   Boolean  @default(false) @map("is_founder")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("startup_members")
}

model StartupStageHistory {
  id          String   @id @default(uuid()) @db.Uuid
  startupId   String   @db.Uuid @map("startup_id")
  fromStageId String?  @db.Uuid @map("from_stage_id")
  toStageId   String   @db.Uuid @map("to_stage_id")
  changedById String   @db.Uuid @map("changed_by_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  startup   Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  fromStage StartupStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   StartupStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  changedBy User          @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([startupId, createdAt])
  @@map("startup_stage_history")
}

model StartupNote {
  id        String   @id @default(uuid()) @db.Uuid
  startupId String   @db.Uuid @map("startup_id")
  authorId  String   @db.Uuid @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([startupId, createdAt])
  @@map("startup_notes")
}

enum StartupFileKind {
  LOGO
  DOCUMENT
}

model StartupFile {
  id          String          @id @default(uuid()) @db.Uuid
  startupId   String          @db.Uuid @map("startup_id")
  kind        StartupFileKind @default(DOCUMENT)
  name        String
  /// S3 ishlatilganda obyekt kaliti; bazada saqlanganda "db:<id>"
  objectKey   String          @unique @map("object_key")
  contentType String          @map("content_type")
  size        Int
  /// S3 sozlanmagan bo‘lsa fayl mazmuni shu yerda saqlanadi
  data        Bytes?
  uploadedBy  String          @db.Uuid @map("uploaded_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  startup  Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([startupId])
  @@map("startup_files")
}

model StartupFinanceProfile {
  startupId       String   @id @db.Uuid @map("startup_id")
  baseCurrency    String   @default("UZS") @db.VarChar(3) @map("base_currency")
  openingBalance  Decimal  @default(0) @db.Decimal(20, 2) @map("opening_balance")
  budgetAmount    Decimal? @db.Decimal(20, 2) @map("budget_amount")
  budgetStartDate DateTime? @db.Date @map("budget_start_date")
  budgetEndDate   DateTime? @db.Date @map("budget_end_date")
  notes           String?
  updatedById     String   @db.Uuid @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("FinanceProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("startup_finance_profiles")
}

model StartupFinanceTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid @map("organization_id")
  startupId       String                   @db.Uuid @map("startup_id")
  fundingRoundId  String?                  @db.Uuid @map("funding_round_id")
  type            FinanceTransactionType
  category        FinanceCategory
  status          FinanceTransactionStatus @default(COMPLETED)
  title           String
  amount          Decimal                  @db.Decimal(20, 2)
  currency        String                   @default("UZS") @db.VarChar(3)
  exchangeRate    Decimal                  @default(1) @db.Decimal(20, 6) @map("exchange_rate")
  baseAmount      Decimal                  @db.Decimal(20, 2) @map("base_amount")
  counterparty    String?
  paymentMethod   String?                  @map("payment_method")
  reference       String?
  occurredAt      DateTime                 @db.Date @map("occurred_at")
  receiptUrl      String?                  @map("receipt_url")
  notes           String?
  createdById     String                   @db.Uuid @map("created_by_id")
  updatedById     String                   @db.Uuid @map("updated_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startup      Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  fundingRound StartupFundingRound? @relation(fields: [fundingRoundId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("FinanceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                 @relation("FinanceTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, startupId, occurredAt])
  @@index([startupId, type, status])
  @@index([fundingRoundId])
  @@map("startup_finance_transactions")
}

model StartupFundingRound {
  id                    String             @id @default(uuid()) @db.Uuid
  organizationId        String             @db.Uuid @map("organization_id")
  startupId             String             @db.Uuid @map("startup_id")
  type                  FundingRoundType
  status                FundingRoundStatus @default(PLANNED)
  name                  String
  targetAmount          Decimal?           @db.Decimal(20, 2) @map("target_amount")
  raisedAmount          Decimal            @default(0) @db.Decimal(20, 2) @map("raised_amount")
  currency              String             @default("UZS") @db.VarChar(3)
  exchangeRate          Decimal            @default(1) @db.Decimal(20, 6) @map("exchange_rate")
  baseRaisedAmount      Decimal            @default(0) @db.Decimal(20, 2) @map("base_raised_amount")
  preMoneyValuation     Decimal?           @db.Decimal(20, 2) @map("pre_money_valuation")
  postMoneyValuation    Decimal?           @db.Decimal(20, 2) @map("post_money_valuation")
  equityPercent         Decimal?           @db.Decimal(7, 4) @map("equity_percent")
  investorName          String?            @map("investor_name")
  openedAt              DateTime?          @db.Date @map("opened_at")
  closedAt              DateTime?          @db.Date @map("closed_at")
  notes                 String?
  createdById           String             @db.Uuid @map("created_by_id")
  updatedById           String             @db.Uuid @map("updated_by_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startup      Startup                     @relation(fields: [startupId], references: [id], onDelete: Cascade)
  transactions StartupFinanceTransaction[]
  createdBy    User                        @relation("FundingRoundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                        @relation("FundingRoundUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, startupId, status])
  @@index([startupId, createdAt])
  @@map("startup_funding_rounds")
}

model StartupMilestone {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid @map("organization_id")
  startupId      String            @db.Uuid @map("startup_id")
  title          String
  description    String?
  status         MilestoneStatus   @default(PLANNED)
  priority       MilestonePriority @default(MEDIUM)
  dueDate        DateTime?         @db.Date @map("due_date")
  completedAt    DateTime?         @map("completed_at")
  assigneeId     String?           @db.Uuid @map("assignee_id")
  createdById    String            @db.Uuid @map("created_by_id")
  updatedById    String            @db.Uuid @map("updated_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startup      Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("MilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("MilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User         @relation("MilestoneUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, startupId, status])
  @@index([startupId, dueDate])
  @@index([assigneeId, status])
  @@map("startup_milestones")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid @map("organization_id")
  name           String
  color          String   @default("#64748B")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startups     StartupTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model StartupTag {
  startupId String @db.Uuid @map("startup_id")
  tagId     String @db.Uuid @map("tag_id")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([startupId, tagId])
  @@map("startup_tags")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid @map("organization_id")
  userId         String?     @db.Uuid @map("user_id")
  action         AuditAction
  entity         String
  entityId       String?     @map("entity_id")
  changes        Json?
  ipAddress      String?     @map("ip_address")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------- Bo'lim kassasi ----------------

enum CashTransactionKind {
  IN
  OUT
  MOVE
}

enum CashAccount {
  CASH
  CARD
}

model CashTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid @map("organization_id")
  kind           CashTransactionKind
  docNo          Int                 @map("doc_no")
  amount         Decimal             @db.Decimal(20, 2)
  date           DateTime            @db.Date
  category       String
  note           String              @default("")
  person         String              @default("")
  quantity       Decimal?            @db.Decimal(14, 3)
  unitPrice      Decimal?            @db.Decimal(20, 2) @map("unit_price")
  account        CashAccount?
  fromAccount    CashAccount?        @map("from_account")
  toAccount      CashAccount?        @map("to_account")
  recipient      String              @default("")
  commissionPct  Decimal             @default(0) @db.Decimal(5, 2) @map("commission_pct")
  commission     Decimal             @default(0) @db.Decimal(20, 2)
  usage          String              @default("")
  startupId      String?             @db.Uuid @map("startup_id")
  receiptId      String?             @db.Uuid @map("receipt_id")
  archivedAt     DateTime?           @map("archived_at")
  archiveReason  String              @default("") @map("archive_reason")
  archivedById   String?             @db.Uuid @map("archived_by_id")
  createdById    String              @db.Uuid @map("created_by_id")
  updatedById    String              @db.Uuid @map("updated_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startup      Startup?     @relation(fields: [startupId], references: [id], onDelete: SetNull)
  receipt      CashReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  archivedBy   User?        @relation("CashTransactionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User         @relation("CashTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind, docNo])
  @@index([organizationId, date])
  @@index([startupId])
  @@map("cash_transactions")
}

model CashReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid @map("organization_id")
  mimeType       String   @map("mime_type")
  size           Int
  fileName       String   @map("file_name")
  data           Bytes
  createdById    String   @db.Uuid @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  transactions CashTransaction[]

  @@index([organizationId])
  @@map("cash_receipts")
}

model CashSettings {
  organizationId String    @id @db.Uuid @map("organization_id")
  orgName        String    @default("TKTI") @map("org_name")
  unitName       String    @default("Startaplarni rivojlantirish va ekotizimni joriy etish bo‘limi") @map("unit_name")
  head           String    @default("")
  accountant     String    @default("")
  openingCash    Decimal   @default(0) @db.Decimal(20, 2) @map("opening_cash")
  openingCard    Decimal   @default(0) @db.Decimal(20, 2) @map("opening_card")
  openingDate    DateTime? @db.Date @map("opening_date")
  defaultCommissionPct Decimal @default(1) @db.Decimal(5, 2) @map("default_commission_pct")
  updatedById    String?   @db.Uuid @map("updated_by_id")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("cash_settings")
}
